{
    "version": 1,
    "servers": [
        {
            "id": "filesystem",
            "name": "Filesystem",
            "category": "Developer Tools",
            "description": "Read, write, and manage files inside a specific local directory.",
            "type": "local",
            "command": "npx -y @modelcontextprotocol/server-filesystem /path/to/allowed/directory",
            "requires": [
                "A local directory path — edit the command above"
            ],
            "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
        },
        {
            "id": "git",
            "name": "Git",
            "category": "Developer Tools",
            "description": "Read commit history, diffs, and branches of a local git repository.",
            "type": "local",
            "command": "uvx mcp-server-git --repository /path/to/repo",
            "requires": [
                "A local git repository path — edit the command above",
                "uv / uvx installed"
            ],
            "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/git"
        },
        {
            "id": "github",
            "name": "GitHub",
            "category": "Developer Tools",
            "description": "Search code, and manage issues and pull requests on GitHub.",
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": ""
            },
            "requires": [
                "A GitHub personal access token — paste it as \"Bearer <token>\" in the Authorization header"
            ],
            "docs": "https://github.com/github/github-mcp-server"
        },
        {
            "id": "everything",
            "name": "Everything",
            "category": "Developer Tools",
            "description": "Reference server exercising the full MCP feature set — useful for testing your setup.",
            "type": "local",
            "command": "npx -y @modelcontextprotocol/server-everything",
            "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/everything"
        },
        {
            "id": "blender-mcp",
            "name": "Blender MCP",
            "category": "3D & Modeling",
            "description": "Control Blender directly using natural language prompts via the Model Context Protocol.",
            "type": "local",
            "command": "uvx blender-mcp",
            "environment": {
                "BLENDER_HOST": "localhost",
                "BLENDER_PORT": "9876"
            },
            "requires": [
                "uv / uvx installed",
                "Blender MCP addon running in Blender"
            ],
            "docs": "https://github.com/ahujasid/blender-mcp"
        },
